#!/usr/bin/env python3
# Odyssey G70 reports a different EDID (and DP port) per boot, so kscreen never finds a saved config for it.
import re
import subprocess

out = subprocess.run(["xrandr", "--prop"], capture_output=True, text=True, check=True).stdout

monitors = {}
for block in re.split(r"\n(?=\S)", out):
    m = re.match(r"(\S+) connected", block)
    if not m:
        continue
    edid = re.search(r"EDID:\s*((?:\s+[0-9a-f]{32}\n?)+)", block)
    raw = bytes.fromhex("".join(edid.group(1).split())) if edid else b""
    name = re.search(rb"\x00\x00\x00\xfc\x00([^\n]*)", raw)
    monitors[m.group(1)] = name.group(1).decode(errors="ignore") if name else ""

center = next((o for o, n in monitors.items() if n.startswith("Odyssey")), None)
right = next((o for o, n in monitors.items() if n.startswith("C27F390")), None)
left = next((o for o in monitors if o not in (center, right)), None)

cmd = ["xrandr"]
if center:
    cmd += ["--output", center, "--primary", "--mode", "2560x1440", "--rate", "144", "--pos", "1920x0"]
if left:
    cmd += ["--output", left, "--mode", "1920x1080", "--pos", "0x180"]
if right:
    cmd += ["--output", right, "--mode", "1920x1080", "--pos", "4480x180"]
subprocess.run(cmd, check=True)
