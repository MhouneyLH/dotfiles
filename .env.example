# Copy this file to .env and fill in values
# .env is gitignored — never commit it

# GitHub PAT for GitHub MCP server
# Create at: github.com → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Scopes: contents:read, pull_requests:read/write, issues:read/write, metadata:read
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
